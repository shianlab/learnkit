{
  "name": "learnkit-framework",
  "productName": "学匣",
  "version": "0.1.0",
  "private": true,
  "description": "可复用的离线音频与文稿学习应用框架",
  "author": "shianlab",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node scripts/prepare-assets.mjs && tsc --noEmit && vite build",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "test:core": "npm test",
    "test": "node scripts/prepare-test-fixture.mjs && node --test tests/*.test.cjs",
    "package": "npm run build && node scripts/package.mjs",
    "build:search": "node scripts/build-search.cjs",
    "prepare:demo": "node scripts/create-demo.mjs && node scripts/import-library.mjs --input ../examples/course-input --mapping ../examples/course-input/courses.json --library-id rikedesk-demo-library",
    "import:library": "node scripts/import-library.mjs"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "dependencies": {
    "lucide-react": "1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.5.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
